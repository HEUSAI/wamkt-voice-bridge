# ── Requerido ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
WAMKT_URL=https://wamkt.notsy.com.mx

# ── Opcionales (tienen default sensato) ───────────────────
PORT=3001
OAI_MODEL=gpt-realtime          # modelo GA Realtime
OAI_VOICE=marin                 # marin | cedar | ...
POOL_SIZE=2                     # conexiones pre-calentadas a OpenAI
VAD_MODE=semantic               # semantic (turnos naturales) | server
VAD_EAGERNESS=medium            # low|medium|high|auto (solo semantic)
VAD_SILENCE_MS=500              # ms de silencio para cerrar turno (solo server)
MAX_CALL_MS=180000              # corte duro de la llamada
BRIDGE_SECRET=                  # secreto compartido para callbacks a WAMKT
OAI_SAFETY_ID=wamkt-voice-bridge

# ── Voz ElevenLabs (opcional — voz mexicana nativa) ───────
# Requiere plan Starter de ElevenLabs (el gratis bloquea las library voices).
TTS_PROVIDER=openai             # openai (default) | elevenlabs
ELEVEN_LABS_API_KEY=            # xi-...  (permisos: Text to Speech + Voices read)
ELEVEN_VOICE_ID=ewn5JTa3lNPY8QVuZJi6   # Ana Sofía (es-MX)
ELEVEN_MODEL=eleven_flash_v2_5  # baja latencia
